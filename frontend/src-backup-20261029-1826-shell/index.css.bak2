:root{--brand:#0f5d46;--dark:#0a3b2d;--kente:#f2b705;--bg:#f1f4f2;--ink:#14201b;--line:#d9e0dc;--mut:#5b6b64}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,"Segoe UI",sans-serif}
h1,h2{font-family:Georgia,serif;color:var(--dark);margin:0}h2{font-size:18px;margin-bottom:10px}a{color:var(--brand)}
:focus-visible{outline:2px solid var(--kente);outline-offset:2px}
.app{display:grid;grid-template-columns:230px 1fr;min-height:100vh}
.side{background:var(--dark);color:#fff;padding:20px 14px;display:flex;flex-direction:column;gap:4px;position:sticky;top:0;height:100vh}
.side .logo{font:20px Georgia,serif;padding:0 10px 18px}
.side a{color:#cfe3da;text-decoration:none;padding:8px 10px;border-radius:6px;display:flex;justify-content:space-between}
.side a.active{background:var(--brand);color:#fff}.side button{margin-top:auto;background:transparent;border:1px solid #4d7d6c}
.main{padding:28px;max-width:1100px;width:100%}
.ph{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px}
.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:18px;margin-bottom:16px}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}
.kpi b{display:block;font:32px Georgia,serif;color:var(--brand)}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);vertical-align:top}th{color:var(--mut);font-weight:500;font-size:13px}
input,select,textarea{width:100%;padding:8px 10px;border:1px solid #b9c4be;border-radius:6px;font:inherit;background:#fff}
.f{display:block;margin-bottom:12px}.f span{display:block;font-size:13px;color:var(--mut);margin-bottom:4px}
.row{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.btn,button{background:var(--brand);color:#fff;border:0;border-radius:6px;padding:8px 14px;font:inherit;cursor:pointer;text-decoration:none;display:inline-block}
.btn:hover,button:hover{background:var(--dark)}
.ghost{background:transparent;color:var(--brand);border:1px solid var(--brand)}.ghost:hover{background:#e4ece8}.danger{background:#a33}
.err{background:#fff6d6;border-left:4px solid var(--kente);padding:9px 12px;border-radius:4px}.ok{color:var(--brand)}
.b{padding:2px 8px;border-radius:10px;background:#e4ece8;font-size:12px}.b-active,.b-acceptee{background:#cdebd9}.b-refusee,.b-archivee,.b-expiree{background:#eee;color:#666}.b-entretien{background:#ffeeb0}
.bar{height:8px;background:#e4ece8;border-radius:4px;overflow:hidden;min-width:80px}.bar i{display:block;height:100%;background:var(--brand)}
.chat{display:grid;grid-template-columns:260px 1fr;gap:16px}
.conv{padding:10px;border-bottom:1px solid var(--line);cursor:pointer}.conv.on{background:#e4ece8}
.msgs{max-height:420px;overflow:auto;display:flex;flex-direction:column;gap:8px;margin-bottom:12px}
.m{max-width:75%;padding:8px 12px;border-radius:10px;background:#e4ece8}.m.me{align-self:flex-end;background:var(--brand);color:#fff}
.auth{max-width:400px;margin:8vh auto;padding:0 16px}.mut{color:var(--mut)}.actions{display:flex;gap:6px;flex-wrap:wrap}
@media(max-width:800px){.app{grid-template-columns:1fr}.side{position:static;height:auto;flex-direction:row;flex-wrap:wrap}.chat{grid-template-columns:1fr}.main{padding:16px}}
.side .who{color:#9dc0b2;font-size:13px;padding:0 10px 14px;margin-top:-10px}
.card{overflow-x:auto}.chips{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}
/* x-redesign */
html[data-theme=dark]{--bg:#0a100e;--ink:#e7f0eb;--line:#1f2e28;--mut:#8aa398;--brand:#19a37a;--dark:#06231b;color-scheme:dark}
html[data-theme=dark] h1,html[data-theme=dark] h2{color:var(--ink)}
html[data-theme=dark] .card{background:#111b17}
html[data-theme=dark] input,html[data-theme=dark] select,html[data-theme=dark] textarea{background:#0d1512;border-color:#274036;color:var(--ink)}
html[data-theme=dark] .b{background:#1b2c25;color:#cfe3da}
html[data-theme=dark] .b-active,html[data-theme=dark] .b-acceptee{background:#14513d}
html[data-theme=dark] .b-entretien{background:#5a4608}
html[data-theme=dark] .bar,html[data-theme=dark] .x-fun-bar{background:#1b2c25}
html[data-theme=dark] tr:hover td{background:#16231e}
html[data-theme=dark] .ghost:hover{background:#16231e}
html[data-theme=dark] .m{background:#1b2c25}.html[data-theme=dark] .conv.on{background:#1b2c25}
body{transition:background .25s,color .25s}
.side{background:linear-gradient(180deg,var(--dark),#052018);box-shadow:4px 0 24px -12px rgba(0,0,0,.4)}
.side .logo{letter-spacing:.3px;background:linear-gradient(90deg,#fff,var(--kente));-webkit-background-clip:text;background-clip:text;color:transparent}
.side a{transition:.18s;border-radius:10px;padding:10px 12px}
.side a:hover{background:rgba(255,255,255,.08);color:#fff;transform:translateX(3px)}
.side a.active{background:linear-gradient(135deg,var(--brand),#14a07a);box-shadow:0 8px 20px -8px #14a07a}
.main{max-width:1280px;margin:0 auto}
.ph h1{font-size:28px;letter-spacing:-.5px}
.card{border-radius:16px;box-shadow:0 1px 2px rgba(15,40,30,.05),0 8px 24px -16px rgba(15,40,30,.18);transition:box-shadow .2s,transform .2s;animation:xup .45s both}
.card:hover{box-shadow:0 12px 32px -14px rgba(15,40,30,.28)}
.btn,button{border-radius:10px;transition:.18s}
.btn:hover,button:hover{transform:translateY(-1px)}
table tr{transition:background .15s}tr:hover td{background:#f6f9f7}
th{text-transform:uppercase;letter-spacing:.05em;font-size:11px}
.b{border-radius:99px;padding:3px 10px;font-weight:600;text-transform:capitalize}
.b-recue{background:#dbeafe;color:#1e40af}.b-en_cours{background:#f3e8ff;color:#6b21a8}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px rgba(15,93,70,.18)}
@keyframes xup{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.x-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 16px;border-radius:12px;font-weight:600;text-decoration:none;border:0;cursor:pointer;color:#fff;background:var(--brand);transition:.18s}
.x-btn:hover{transform:translateY(-2px);background:var(--brand);filter:brightness(1.1)}
.x-btn.light{background:rgba(255,255,255,.16);color:#fff;backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.3)}
.x-btn.gold{background:var(--kente);color:#2a2000}
.x-btn.small{padding:6px 12px;font-size:13px;border-radius:9px}
.x-theme{background:var(--bg);color:var(--ink);border:1px solid var(--line);padding:8px 14px;border-radius:12px}
.x-theme:hover{background:var(--line)}
.x-hero{display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;padding:28px 30px;border-radius:20px;margin-bottom:18px;color:#fff;position:relative;overflow:hidden;background:radial-gradient(circle at 90% 0,rgba(242,183,5,.35),transparent 45%),linear-gradient(135deg,#0a3b2d,#0f7a5c)}
.x-hero small{opacity:.8;text-transform:capitalize}
.x-hero h2{color:#fff;font-size:30px;margin:4px 0 6px}
.x-hero p{margin:0;opacity:.92;max-width:520px}
.x-hero-btns{display:flex;gap:10px;flex-wrap:wrap}
.x-kpis{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));margin-bottom:16px}
.x-kpi{position:relative;background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;overflow:hidden;animation:xup .5s both;transition:.2s}
.x-kpi:hover{transform:translateY(-3px);box-shadow:0 14px 30px -16px var(--c)}
.x-kpi::after{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c)}
html[data-theme=dark] .x-kpi{background:#111b17}
.x-kpi span{display:block;color:var(--mut);font-size:13px}
.x-kpi b{display:block;font:700 34px Georgia,serif;margin:4px 0;color:var(--ink)}
.x-kpi em{font-style:normal;font-size:12px;color:var(--c);font-weight:600}
.x-ico{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;font-size:18px;margin-bottom:10px;background:color-mix(in srgb,var(--c) 14%,transparent)}
.x-grid{display:grid;gap:16px;grid-template-columns:2fr 1fr;margin-bottom:0}
.x-grid2{display:grid;gap:16px;grid-template-columns:1fr 1fr}
.x-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:10px}
.x-head h2{margin:0}
.x-chips{display:flex;gap:6px}
.x-chip{background:var(--bg);color:var(--mut);border:1px solid var(--line);padding:4px 12px;border-radius:99px;font-size:13px}
.x-chip:hover{background:var(--line);color:var(--ink)}
.x-chip.on{background:var(--brand);color:#fff;border-color:var(--brand)}
.x-legend{display:flex;flex-direction:column;gap:8px;margin-top:14px;font-size:14px}
.x-legend div{display:flex;align-items:center;gap:8px}
.x-legend i{width:10px;height:10px;border-radius:50%}
.x-legend b{margin-left:auto}
.x-fun{margin-bottom:14px}
.x-fun-top{display:flex;justify-content:space-between;margin-bottom:5px}
.x-fun-bar{height:14px;background:#e4ece8;border-radius:99px;overflow:hidden}
.x-fun-bar i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--brand),#14a07a);transition:width .8s}
.x-fun small{color:var(--mut);font-size:12px}
.x-count{background:var(--kente);color:#2a2000;border-radius:99px;padding:2px 10px;font-weight:700;font-size:13px}
.x-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
.x-row:last-child{border-bottom:0}
.x-row-t{flex:1;min-width:0}.x-row-t strong{display:block}.x-row-t small{color:var(--mut)}
.x-av{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-weight:700;color:#fff;flex:none;background:linear-gradient(135deg,var(--brand),var(--kente))}
.x-tl{position:relative;padding-left:18px}
.x-tl::before{content:"";position:absolute;left:5px;top:6px;bottom:6px;width:2px;background:var(--line)}
.x-tl-i{position:relative;margin-bottom:14px}
.x-tl-i i{position:absolute;left:-18px;top:5px;width:12px;height:12px;border-radius:50%;border:2px solid var(--bg)}
.x-tl-i small{display:block;color:var(--mut);margin-top:2px}
@media(max-width:1000px){.x-grid,.x-grid2{grid-template-columns:1fr}.x-hero{padding:22px}}