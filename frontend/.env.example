######## models\offre.py ########
1  import uuid
2  from datetime import datetime
3  
4  from sqlalchemy import Integer
5  from sqlalchemy import Column, DateTime, Enum, Float, ForeignKey, String, Text
6  from sqlalchemy.orm import relationship
7  
8  from app.core.database import Base
9  from app.core.types import GUID
10  
11  
12  class Offre(Base):
13      __tablename__ = "offres"
14  
15      id = Column(GUID(), primary_key=True, default=uuid.uuid4)
16      entreprise_id = Column(GUID(), ForeignKey("entreprise_profiles.id"), nullable=False)
17  
18      titre = Column(String, nullable=False)
19      description = Column(Text, nullable=True)
20      type_contrat = Column(
21          Enum("stage", "cdd", "cdi", "mission", name="type_contrat"),
22          nullable=False,
23      )
24  
25      competences_obligatoires = Column(Text, nullable=True)
26      competences_souhaitees = Column(Text, nullable=True)
27      soft_skills = Column(Text, nullable=True)
28  
29      niveau_experience = Column(String, nullable=True)
30      disponibilite = Column(String, nullable=True)
31      localisation = Column(String, nullable=True)
32      remuneration = Column(Float, nullable=True)
33      budget_tjm = Column(
34          Float, nullable=True
35      )  # taux journalier propose, pour les missions freelance
36  
37      nombre_postes = Column(Integer, nullable=False, default=1, server_default="1")
38  
39      statut = Column(
40          Enum("active", "expiree", "archivee", "pourvue", name="statut_offre"),
41          nullable=False,
42          default="active",
43      )
44  
45      created_at = Column(DateTime, default=datetime.utcnow)
46      updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)
47  
48      entreprise = relationship("EntrepriseProfile")
######## models\candidature.py ########
1  import uuid
2  from datetime import datetime
3  
4  from sqlalchemy import Column, DateTime, Enum, ForeignKey, Text, UniqueConstraint
5  from sqlalchemy.orm import relationship
6  
7  from app.core.database import Base
8  from app.core.types import GUID
9  
10  
11  class Candidature(Base):
12      __tablename__ = "candidatures"
13      __table_args__ = (
14          UniqueConstraint("offre_id", "candidat_id", name="uq_candidature_offre_candidat"),
15      )
16  
17      id = Column(GUID(), primary_key=True, default=uuid.uuid4)
18      offre_id = Column(GUID(), ForeignKey("offres.id"), nullable=False)
19      candidat_id = Column(GUID(), ForeignKey("users.id"), nullable=False)
20  
21      message = Column(Text, nullable=True)  # lettre de motivation courte, optionnelle
22  
23      statut = Column(
24          Enum("recue", "en_cours", "entretien", "refusee", "acceptee", name="statut_candidature"),
25          nullable=False,
26          default="recue",
27      )
28  
29      created_at = Column(DateTime, default=datetime.utcnow)
30      updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)
31  
32      offre = relationship("Offre")
33      candidat = relationship("User")
######## models\entretien.py ########
1  import uuid
2  from datetime import datetime
3  
4  from sqlalchemy import Column, DateTime, Enum, ForeignKey, Integer, String, Text
5  from sqlalchemy.orm import relationship
6  
7  from app.core.database import Base
8  from app.core.types import GUID
9  
10  
11  class Entretien(Base):
12      __tablename__ = "entretiens"
13  
14      id = Column(GUID(), primary_key=True, default=uuid.uuid4)
15      candidature_id = Column(
16          GUID(), ForeignKey("candidatures.id", ondelete="CASCADE"), nullable=False, index=True
17      )
18  
19      date_heure = Column(DateTime, nullable=False)  # en UTC
20      duree_minutes = Column(Integer, nullable=False, default=30)
21      mode = Column(
22          Enum("visio", "presentiel", "telephone", name="mode_entretien"),
23          nullable=False,
24          default="visio",
25      )
26      lieu_ou_lien = Column(String, nullable=True)
27      fuseau = Column(String, nullable=True)  # fuseau IANA de l'entreprise (ex: Africa/Dakar)
28      message = Column(Text, nullable=True)  # instructions visibles par le candidat
29  
30      statut = Column(
31          Enum("planifie", "annule", "termine", name="statut_entretien"),
32          nullable=False,
33          default="planifie",
34      )
35  
36      created_at = Column(DateTime, default=datetime.utcnow)
37      updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)
38  
39      candidature = relationship("Candidature")
######## models\mission.py ########
1  import uuid
2  from datetime import datetime
3  
4  from sqlalchemy import Boolean, Column, Date, DateTime, Enum, ForeignKey, Integer, String, Text
5  from sqlalchemy.orm import relationship
6  
7  from app.core.database import Base
8  from app.core.types import GUID
9  
10  
11  class Mission(Base):
12      __tablename__ = "missions"
13  
14      id = Column(GUID(), primary_key=True, default=uuid.uuid4)
15      candidature_id = Column(
16          GUID(), ForeignKey("candidatures.id", ondelete="CASCADE"), nullable=False, index=True
17      )
18      titre = Column(String, nullable=False)
19      description = Column(Text, nullable=True)
20      date_debut = Column(Date, nullable=True)
21      date_fin = Column(Date, nullable=True)
22      avancement = Column(Integer, nullable=False, default=0)  # 0 a 100
23      statut = Column(
24          Enum("en_cours", "en_pause", "terminee", "annulee", name="statut_mission"),
25          nullable=False,
26          default="en_cours",
27      )
28      created_at = Column(DateTime, default=datetime.utcnow)
29      updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow)
30  
31      candidature = relationship("Candidature")
32      jalons = relationship(
33          "MissionJalon",
34          cascade="all, delete-orphan",
35          order_by="MissionJalon.position",
36          back_populates="mission",
37      )
38      notes = relationship(
39          "MissionNote",
40          cascade="all, delete-orphan",
41          order_by="MissionNote.created_at.desc()",
42          back_populates="mission",
43      )
44  
45  
46  class MissionJalon(Base):
47      __tablename__ = "mission_jalons"
48  
49      id = Column(GUID(), primary_key=True, default=uuid.uuid4)
50      mission_id = Column(
51          GUID(), ForeignKey("missions.id", ondelete="CASCADE"), nullable=False, index=True
52      )
53      titre = Column(String, nullable=False)
54      date_prevue = Column(Date, nullable=True)
55      fait = Column(Boolean, nullable=False, default=False)
56      position = Column(Integer, nullable=False, default=0)
57  
58      mission = relationship("Mission", back_populates="jalons")
59  
60  
61  class MissionNote(Base):
62      __tablename__ = "mission_notes"
63  
64      id = Column(GUID(), primary_key=True, default=uuid.uuid4)
65      mission_id = Column(
66          GUID(), ForeignKey("missions.id", ondelete="CASCADE"), nullable=False, index=True
67      )
68      contenu = Column(Text, nullable=False)
69      avancement = Column(Integer, nullable=True)  # avancement au moment de la note
70      created_at = Column(DateTime, default=datetime.utcnow)
71  
72      mission = relationship("Mission", back_populates="notes")
######## models\notification.py ########
1  import uuid
2  from datetime import datetime
3  
4  from sqlalchemy import Boolean, Column, DateTime, ForeignKey, String, Text
5  from sqlalchemy.orm import relationship
6  
7  from app.core.database import Base
8  from app.core.types import GUID
9  
10  
11  class Notification(Base):
12      __tablename__ = "notifications"
13  
14      id = Column(GUID(), primary_key=True, default=uuid.uuid4)
15      user_id = Column(GUID(), ForeignKey("users.id"), nullable=False)
16  
17      titre = Column(String, nullable=False)
18      message = Column(Text, nullable=True)
19      type_evenement = Column(String, nullable=False)  # ex: "candidature_recue", "statut_change"
20  
21      lue = Column(Boolean, nullable=False, default=False)
22      created_at = Column(DateTime, default=datetime.utcnow)
23  
24      user = relationship("User")
######## schemas\offre.py ########
1  import uuid
2  from datetime import datetime
3  from typing import Literal
4  
5  from pydantic import BaseModel, Field
6  
7  DisponibiliteOffre = Literal["immediate", "1_mois", "3_mois", "6_mois"]
8  
9  
10  class OffreCreate(BaseModel):
11      titre: str = Field(min_length=3)
12      description: str | None = None
13      type_contrat: Literal["stage", "cdd", "cdi", "mission"]
14      competences_obligatoires: str | None = None
15      competences_souhaitees: str | None = None
16      soft_skills: str | None = None
17      niveau_experience: str | None = None
18      disponibilite: DisponibiliteOffre | None = None
19      localisation: str | None = None
20      remuneration: float | None = Field(default=None, ge=0)
21      budget_tjm: float | None = Field(default=None, ge=0)
22      nombre_postes: int = Field(default=1, ge=1, le=100)
23  
24  
25  class OffreUpdate(BaseModel):
26      titre: str | None = Field(default=None, min_length=3)
27      description: str | None = None
28      type_contrat: Literal["stage", "cdd", "cdi", "mission"] | None = None
29      competences_obligatoires: str | None = None
30      competences_souhaitees: str | None = None
31      soft_skills: str | None = None
32      niveau_experience: str | None = None
33      disponibilite: DisponibiliteOffre | None = None
34      localisation: str | None = None
35      remuneration: float | None = Field(default=None, ge=0)
36      budget_tjm: float | None = Field(default=None, ge=0)
37      nombre_postes: int | None = Field(default=None, ge=1, le=100)
38      statut: Literal["active", "expiree", "archivee", "pourvue"] | None = None
39  
40  
41  class OffreOut(BaseModel):
42      id: uuid.UUID
43      entreprise_id: uuid.UUID
44      titre: str
45      description: str | None
46      type_contrat: str
47      competences_obligatoires: str | None
48      competences_souhaitees: str | None
49      soft_skills: str | None
50      niveau_experience: str | None
51      disponibilite: str | None  # tolerant : ne casse pas la lecture de donnees existantes
52      localisation: str | None
53      remuneration: float | None
54      budget_tjm: float | None
55      statut: str
56      nombre_postes: int = 1
57      created_at: datetime
58  
59      class Config:
60          from_attributes = True